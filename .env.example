# Public host ports
FRONTEND_PORT=3000
PROXY_PORT=8888

# Container data paths
DB_PATH=/data/netshield.db
VAULT_PATH=/vault

# Required: replace both values with strong, unique secrets before deploying.
# SERVER_SECRET must be at least 32 characters.
# SERVER_MASTER_PASSWORD must be at least 16 characters.
SERVER_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SERVER_MASTER_PASSWORD=replace-with-a-strong-vault-password-of-at-least-16-characters
VAULT_EXPIRY_HOURS=1
